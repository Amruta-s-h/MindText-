# MindText Backend Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=mindtext-dev-secret-key-change-in-production

# SQLite Database Storage
DATABASE_URL=sqlite:///instance/mindtext.db

# OpenAI API Integration
# Optional: If omitted or invalid, the backend automatically uses
# an intelligent rule-based explanation fallback without errors.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
